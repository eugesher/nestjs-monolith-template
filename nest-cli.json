{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "root": "apps",
  "monorepo": true,
  "compilerOptions": {
    "builder": "rspack",
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json"
  },
  "projects": {
    "staff-app": {
      "type": "application",
      "root": "apps/staff-app",
      "entryFile": "main",
      "sourceRoot": "apps/staff-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/staff-app/tsconfig.app.json"
      }
    },
    "customer-app": {
      "type": "application",
      "root": "apps/customer-app",
      "entryFile": "main",
      "sourceRoot": "apps/customer-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/customer-app/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "cache": {
