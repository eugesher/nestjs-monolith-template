{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "root": "apps",
  "monorepo": true,
  "compilerOptions": {
    "builder": "rspack",
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json"
  },
  "projects": {
    "admin-api": {
      "type": "application",
      "root": "apps/admin-api",
      "entryFile": "main",
      "sourceRoot": "apps/admin-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-api/tsconfig.app.json"
      }
    },
    "client-api": {
      "type": "application",
      "root": "apps/client-api",
      "entryFile": "main",
      "sourceRoot": "apps/client-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/client-api/tsconfig.app.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "kernel": {
      "type": "library",
      "root": "libs/kernel",
      "entryFile": "index",
      "sourceRoot": "libs/kernel/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kernel/tsconfig.lib.json"
      }
    },
    "observability": {
      "type": "library",
      "root": "libs/observability",
      "entryFile": "index",
      "sourceRoot": "libs/observability/src",
      "compilerOptions": {
        "tsConfigPath": "libs/observability/tsconfig.lib.json"
      }
    },
    "toolkit": {
      "type": "library",
      "root": "libs/toolkit",
      "entryFile": "index",
      "sourceRoot": "libs/toolkit/src",
      "compilerOptions": {
        "tsConfigPath": "libs/toolkit/tsconfig.lib.json"
      }
    }
  }
}
