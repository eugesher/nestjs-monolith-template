{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "root": "apps",
  "monorepo": true,
  "compilerOptions": {
    "builder": "rspack",
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json"
  },
  "projects": {
    "admin-api": {
      "type": "application",
      "root": "apps/admin-api",
      "entryFile": "main",
      "sourceRoot": "apps/admin-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-api/tsconfig.app.json"
      }
    },
    "client-api": {
      "type": "application",
      "root": "apps/client-api",
      "entryFile": "main",
      "sourceRoot": "apps/client-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/client-api/tsconfig.app.json"
      }
    },
    "cache": {
      "type": "library",
      "root": "libs/cache",
      "entryFile": "index",
      "sourceRoot": "libs/cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cache/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "contracts-cache": {
      "type": "library",
      "root": "libs/contracts/src/cache",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src/cache",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "contracts-database": {
      "type": "library",
      "root": "libs/contracts/src/database",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src/database",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "contracts-messaging": {
      "type": "library",
      "root": "libs/contracts/src/messaging",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src/messaging",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "core-entities": {
      "type": "library",
      "root": "core/entities",
      "entryFile": "index",
      "sourceRoot": "core/entities/src",
      "compilerOptions": {
        "tsConfigPath": "core/entities/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "http": {
      "type": "library",
      "root": "libs/http",
      "entryFile": "index",
      "sourceRoot": "libs/http/src",
      "compilerOptions": {
        "tsConfigPath": "libs/http/tsconfig.lib.json"
      }
    },
    "kernel": {
      "type": "library",
      "root": "libs/kernel",
      "entryFile": "index",
      "sourceRoot": "libs/kernel/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kernel/tsconfig.lib.json"
      }
    },
    "messaging": {
      "type": "library",
      "root": "libs/messaging",
      "entryFile": "index",
      "sourceRoot": "libs/messaging/src",
      "compilerOptions": {
        "tsConfigPath": "libs/messaging/tsconfig.lib.json"
      }
    },
    "observability": {
      "type": "library",
      "root": "libs/observability",
      "entryFile": "index",
      "sourceRoot": "libs/observability/src",
      "compilerOptions": {
        "tsConfigPath": "libs/observability/tsconfig.lib.json"
      }
    },
    "openapi": {
      "type": "library",
      "root": "libs/openapi",
      "entryFile": "index",
      "sourceRoot": "libs/openapi/src",
      "compilerOptions": {
        "tsConfigPath": "libs/openapi/tsconfig.lib.json"
      }
    },
    "toolkit": {
      "type": "library",
      "root": "libs/toolkit",
      "entryFile": "index",
      "sourceRoot": "libs/toolkit/src",
      "compilerOptions": {
        "tsConfigPath": "libs/toolkit/tsconfig.lib.json"
      }
    }
  }
}
