# Copy to .env.local (gitignored) and fill in real values for local development:
#
#   cp .env.example .env.local
#
# .env.example is the only tracked env file. Each app validates its own subset at boot
# (apps/<app>/src/app/setup/config): a missing or invalid required value stops the app
# with a Joi error instead of failing at first use.

NODE_ENV=development

# ── Shared by both apps ───────────────────────────────────────────────────────

API_PREFIX=api
# API_USE_API_REFERENCE=true   # defaults to true outside production

DATABASE_URL=mysql://acme:acmepass@localhost:3306/acme_db
DATABASE_LOGGING=true

REDIS_URL=redis://localhost:6379
CACHE_TTL_MS_DEFAULT=60000

# Attempts of an optimistic-concurrency write before it surfaces a 409 VERSION_MISMATCH.
OCC_RETRY_ATTEMPTS=5

# 32+ characters each, and the two must differ: boot refuses otherwise.
# Development throwaways, never real secrets.
JWT_ACCESS_SECRET=development-access-secret-do-not-use-in-prod-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development-refresh-secret-do-not-use-in-prod-32
JWT_REFRESH_EXPIRES_IN=7d

# argon2id cost parameters (OWASP guidance).
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Tracing is off by default so the stack runs without a collector.
# OTEL_SERVICE_NAME defaults to the app name (admin-api / client-api).
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=team=platform

# ── admin-api ─────────────────────────────────────────────────────────────────

ADMIN_API_PORT=3001

# ── client-api ────────────────────────────────────────────────────────────────

CLIENT_API_PORT=3000

# Idempotency-key retention. Keep it longer than any client's retry budget: purging a
# record retires the ability to recognize that request as a replay.
IDEMPOTENCY_KEY_TTL_HOURS=24
