{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@acme-staff-app": ["./apps/staff-app/src/app/app.module"],
      "@acme-staff-common/modules/staff-identity": [
        "./apps/staff-app/src/common/modules/staff-identity"
      ],
      "@acme-staff-common/shared/concurrency": ["./apps/staff-app/src/common/shared/concurrency"],
      "@acme-staff-common/shared/ledger-record": [
        "./apps/staff-app/src/common/shared/ledger-record"
      ],
      "@acme-staff-contracts/staff-identity": ["./apps/staff-app/src/contracts/staff-identity"],
      "@acme-staff-features": ["./apps/staff-app/src/features"],
      "@acme-customer-app": ["./apps/customer-app/src/app/app.module"],
      "@acme-customer-common/modules/customer-identity": [
        "./apps/customer-app/src/common/modules/customer-identity"
      ],
      "@acme-customer-common/shared/ledger-record": [
        "./apps/customer-app/src/common/shared/ledger-record"
      ],
      "@acme-customer-contracts/customer-identity": [
        "./apps/customer-app/src/contracts/customer-identity"
      ],
      "@acme-customer-features": ["./apps/customer-app/src/features"],
      "@acme-processor-app": ["./apps/processor-app/src/app/app.module"],
      "@acme-processor-common/shared/ledger-record": [
        "./apps/processor-app/src/common/shared/ledger-record"
      ],
      "@acme-processor-features": ["./apps/processor-app/src/features"],
      "@acme-processor-processors": ["./apps/processor-app/src/processors"],
      "@acme-core/contracts/idempotency": ["./core/contracts/src/idempotency"],
      "@acme-core/contracts/ledger": ["./core/contracts/src/ledger"],
      "@acme-core/contracts/product-stock": ["./core/contracts/src/product-stock"],
      "@acme-core/entities": ["./core/entities/src"],
      "@acme-core/modules/idempotency": ["./core/modules/src/idempotency"],
      "@acme-core/modules/ledger": ["./core/modules/src/ledger"],
      "@acme-core/modules/product-stock": ["./core/modules/src/product-stock"],
      "@acme-libs/auth": ["./libs/auth/src"],
      "@acme-libs/cache": ["./libs/cache/src"],
      "@acme-libs/cache/testing": ["./libs/cache/src/testing"],
      "@acme-libs/config": ["./libs/config/src"],
      "@acme-libs/contracts/auth": ["./libs/contracts/src/auth"],
      "@acme-libs/contracts/cache": ["./libs/contracts/src/cache"],
      "@acme-libs/contracts/credentials": ["./libs/contracts/src/credentials"],
      "@acme-libs/contracts/database": ["./libs/contracts/src/database"],
      "@acme-libs/contracts/health": ["./libs/contracts/src/health"],
      "@acme-libs/credentials": ["./libs/credentials/src"],
      "@acme-libs/database": ["./libs/database/src"],
      "@acme-libs/health": ["./libs/health/src"],
      "@acme-libs/http": ["./libs/http/src"],
      "@acme-libs/kernel": ["./libs/kernel/src"],
      "@acme-libs/observability": ["./libs/observability/src"],
      "@acme-libs/observability/testing": ["./libs/observability/src/testing"],
      "@acme-libs/observability/tracer": ["./libs/observability/src/tracer/tracer"],
      "@acme-libs/openapi": ["./libs/openapi/src"],
      "@acme-libs/toolkit": ["./libs/toolkit/src"]
    }
  },
  "include": ["apps/**/*.ts", "core/**/*.ts", "libs/**/*.ts", "spec/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
