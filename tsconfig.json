{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@acme-libs/cache": ["./libs/cache/src"],
      "@acme-libs/cache/testing": ["./libs/cache/src/testing"],
      "@acme-libs/config": ["./libs/config/src"],
      "@acme-libs/contracts/cache": ["./libs/contracts/src/cache"],
      "@acme-libs/contracts/database": ["./libs/contracts/src/database"],
      "@acme-libs/contracts/messaging": ["./libs/contracts/src/messaging"],
      "@acme-libs/database": ["./libs/database/src"],
      "@acme-libs/kernel": ["./libs/kernel/src"],
      "@acme-libs/messaging": ["./libs/messaging/src"],
      "@acme-libs/observability": ["./libs/observability/src"],
      "@acme-libs/observability/testing": ["./libs/observability/src/testing"],
      "@acme-libs/observability/tracer": ["./libs/observability/src/tracer/tracer"],
      "@acme-libs/toolkit": ["./libs/toolkit/src"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "spec/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
