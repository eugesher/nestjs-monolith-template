{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@acme-admin-features": ["./apps/admin-api/src/features"],
      "@acme-client-common/modules/idempotency": [
        "./apps/client-api/src/common/modules/idempotency"
      ],
      "@acme-client-common/shared/concurrency": ["./apps/client-api/src/common/shared/concurrency"],
      "@acme-client-common/shared/idempotency": ["./apps/client-api/src/common/shared/idempotency"],
      "@acme-client-contracts/idempotency": ["./apps/client-api/src/contracts/idempotency"],
      "@acme-client-contracts/ledger-catalog-events": [
        "./apps/client-api/src/contracts/ledger-catalog-events"
      ],
      "@acme-client-features": ["./apps/client-api/src/features"],
      "@acme-client-processors": ["./apps/client-api/src/processors"],
      "@acme-core/contracts/identity": ["./core/contracts/src/identity"],
      "@acme-core/contracts/ledger": ["./core/contracts/src/ledger"],
      "@acme-core/entities": ["./core/entities/src"],
      "@acme-core/modules/identity": ["./core/modules/src/identity"],
      "@acme-core/modules/ledger": ["./core/modules/src/ledger"],
      "@acme-libs/auth": ["./libs/auth/src"],
      "@acme-libs/cache": ["./libs/cache/src"],
      "@acme-libs/cache/testing": ["./libs/cache/src/testing"],
      "@acme-libs/config": ["./libs/config/src"],
      "@acme-libs/contracts/auth": ["./libs/contracts/src/auth"],
      "@acme-libs/contracts/cache": ["./libs/contracts/src/cache"],
      "@acme-libs/contracts/database": ["./libs/contracts/src/database"],
      "@acme-libs/contracts/health": ["./libs/contracts/src/health"],
      "@acme-libs/contracts/messaging": ["./libs/contracts/src/messaging"],
      "@acme-libs/database": ["./libs/database/src"],
      "@acme-libs/health": ["./libs/health/src"],
      "@acme-libs/http": ["./libs/http/src"],
      "@acme-libs/kernel": ["./libs/kernel/src"],
      "@acme-libs/messaging": ["./libs/messaging/src"],
      "@acme-libs/observability": ["./libs/observability/src"],
      "@acme-libs/observability/testing": ["./libs/observability/src/testing"],
      "@acme-libs/observability/tracer": ["./libs/observability/src/tracer/tracer"],
      "@acme-libs/openapi": ["./libs/openapi/src"],
      "@acme-libs/toolkit": ["./libs/toolkit/src"]
    }
  },
  "include": ["apps/**/*.ts", "core/**/*.ts", "libs/**/*.ts", "spec/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
