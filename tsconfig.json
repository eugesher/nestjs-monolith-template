{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@acme-staff-app/*": ["./apps/staff-app/src/app/*"],
      "@acme-staff-common/*": ["./apps/staff-app/src/common/*"],
      "@acme-staff-contracts/*": ["./apps/staff-app/src/contracts/*"],
      "@acme-staff-features": ["./apps/staff-app/src/features"],
      "@acme-customer-app/*": ["./apps/customer-app/src/app/*"],
      "@acme-customer-common/*": ["./apps/customer-app/src/common/*"],
      "@acme-customer-features": ["./apps/customer-app/src/features"],
      "@acme-processor-app/*": ["./apps/processor-app/src/app/*"],
      "@acme-processor-common/*": ["./apps/processor-app/src/common/*"],
      "@acme-processor-features": ["./apps/processor-app/src/features"],
      "@acme-processor-processors": ["./apps/processor-app/src/processors"],
      "@acme-core-contracts/*": ["./core/contracts/src/*"],
      "@acme-core-entities": ["./core/entities/src"],
      "@acme-core-modules/*": ["./core/modules/src/*"],
      "@acme-libs-auth": ["./libs/auth/src"],
      "@acme-libs-cache": ["./libs/cache/src"],
      "@acme-libs-cache/*": ["./libs/cache/src/*"],
      "@acme-libs-config": ["./libs/config/src"],
      "@acme-libs-contracts/*": ["./libs/contracts/src/*"],
      "@acme-libs-credentials": ["./libs/credentials/src"],
      "@acme-libs-database": ["./libs/database/src"],
      "@acme-libs-health": ["./libs/health/src"],
      "@acme-libs-http": ["./libs/http/src"],
      "@acme-libs-kernel": ["./libs/kernel/src"],
      "@acme-libs-observability": ["./libs/observability/src"],
      "@acme-libs-observability/*": ["./libs/observability/src/*"],
      "@acme-libs-openapi": ["./libs/openapi/src"],
      "@acme-libs-toolkit": ["./libs/toolkit/src"]
    }
  },
  "include": ["apps/**/*.ts", "core/**/*.ts", "libs/**/*.ts", "spec/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
