exports[`App Auth POST /api/auth/register should create a customer who logs in and record the registration in the ledger under the correlation id 1`] = `
{
  "db": {
    "customer": [
      {
        "created_at": Any<Date>,
        "email": "eve@example.com",
        "id": Any<String>,
        "password_hash": Any<String>,
        "status": "active",
      },
    ],
    "ledger_entry": [
      {
        "action": "CustomerRegistered",
        "correlation_id": "e2e-customer-register",
        "id": Any<String>,
        "occurred_at": Any<Date>,
        "operation_key": Any<String>,
        "payload": {},
        "recorded_at": Any<Date>,
        "subject_id": Any<String>,
        "subject_type": "customer",
      },
    ],
  },
  "me": {
    "email": "eve@example.com",
    "id": Any<String>,
  },
  "response": {
    "body": {
      "email": "eve@example.com",
      "id": Any<String>,
    },
  },
}
`;

exports[`App Auth POST /api/auth/register should let one of two simultaneous sign-ups with one email through and refuse the other with 409 1`] = `
