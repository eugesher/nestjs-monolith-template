exports[`App Auth POST /api/auth/login should issue an access token of the subject alone, valid for the lifetime of this app 1`] = `
{
  "claims": [
    "exp",
    "iat",
    "sub",
  ],
  "lifetime": 604800,
  "me": {
    "email": "ann@example.com",
    "id": "00000000-0000-4000-8000-000000000101",
  },
  "response": {
    "body": {
      "accessToken": Any<String>,
    },
  },
}
`;

exports[`App Auth POST /api/auth/login should refuse a disabled customer with 403 1`] = `
{
  "response": {
    "body": {
      "code": "AUTH_USER_INACTIVE",
      "message": "Customer 00000000-0000-4000-8000-000000000104 is disabled",
      "statusCode": 403,
    },
  },
}
`;

