exports[`App Auth POST /api/auth/register should create a customer who logs in and enqueue the ledger record of the registration with the email under the correlation id 1`] = `
{
  "db": {
    "customer": [
      {
        "created_at": Any<Date>,
        "email": "eve@example.com",
        "id": Any<String>,
        "password_hash": Any<String>,
        "status": "active",
      },
    ],
    "ledger_entry": [],
  },
  "ledger_record_queue": [
    {
      "action": "CustomerRegistered",
      "correlationId": "e2e-customer-register",
      "occurredAt": Any<String>,
      "operationKey": Any<String>,
      "payload": {
        "email": "eve@example.com",
      },
      "subjectId": Any<String>,
      "subjectType": "customer",
    },
  ],
  "me": {
    "email": "eve@example.com",
    "id": Any<String>,
  },
  "response": {
    "body": {
      "email": "eve@example.com",
      "id": Any<String>,
    },
  },
}
`;

exports[`App Auth POST /api/auth/register should let one of two simultaneous sign-ups with one email through and refuse the other with 409 1`] = `
{
  "db": {
    "customer": [
      {
        "email": "gina@example.com",
      },
    ],
  },
  "refused": {
    "body": {
      "code": "AUTH_EMAIL_TAKEN",
      "message": "Email gina@example.com is already registered",
      "statusCode": 409,
    },
  },
  "statuses": [
    201,
    409,
  ],
}
`;

exports[`App Auth POST /api/auth/register should refuse a malformed email with 400 from validation and store nothing 1`] = `
{
  "db": {
    "customer": [],
