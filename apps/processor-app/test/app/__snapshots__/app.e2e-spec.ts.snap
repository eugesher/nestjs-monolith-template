exports[`App Queue PUT /api/queues/:queueName/jobs/failed/:jobId should refuse a job that is not failed with 409 QUEUE_JOB_NOT_FAILED 1`] = `
{
  "response": {
    "body": {
      "code": "QUEUE_JOB_NOT_FAILED",
      "message": StringMatching /\\^Job \\\\S\\+ of queue ledger-record is delayed, not failed\\$/,
      "statusCode": 409,
    },
  },
}
`;

