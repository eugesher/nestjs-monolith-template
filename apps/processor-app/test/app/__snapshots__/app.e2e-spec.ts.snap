exports[`App Auth POST /api/auth/login should answer 429 to an address that spends the auth limit and keep serving another address 1`] = `
{
  "blocked": {
    "body": {
      "message": "Too many requests",
      "statusCode": 429,
    },
    "retryAfter": StringMatching /\\^\\\\d\\+\\$/,
  },
  "other": {
    "body": {
      "code": "AUTH_INVALID_CREDENTIALS",
      "message": "Invalid credentials",
      "statusCode": 401,
    },
  },
}
`;

