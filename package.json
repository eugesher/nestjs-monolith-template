{
  "name": "nestjs-monolith-template",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "nest build admin-api && nest build client-api",
    "build:admin-api": "nest build admin-api",
    "build:client-api": "nest build client-api",
    "start:dev": "bash scripts/bash/start-dev.sh",
    "start:dev:admin-api": "nest start admin-api --watch",
    "start:dev:client-api": "nest start client-api --watch",
    "start:prod:admin-api": "node dist/apps/admin-api/main.js",
    "start:prod:client-api": "node dist/apps/client-api/main.js",
    "format": "prettier --write \"{apps,core,libs,migrations,spec,scripts,test}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,core,libs,migrations,spec,scripts,test}/**/*.ts\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p migrations && tsc -p scripts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config ./test/jest-unit.config.js",
    "migration:cli": "node ./node_modules/typeorm/cli.js -d ./migrations/config/data-source.ts",
    "migration:create": "node ./scripts/migration-create.ts",
    "migration:run": "yarn migration:cli migration:run",
    "migration:revert": "yarn migration:cli migration:revert",
    "migration:show": "yarn migration:cli migration:show"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-typeorm": "2.0.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/typeorm": "12.0.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scalar/nestjs-api-reference": "1.2.31",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "joi": "18.3.0",
    "mysql2": "3.24.6",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@rspack/core": "2.2.9",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "ts-checker-rspack-plugin": "1.7.2",
    "ts-jest": "29.4.15",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "webpack-node-externals": "3.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
