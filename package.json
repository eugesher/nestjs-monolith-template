{
  "name": "nestjs-monolith-template",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "nest build staff-app && nest build customer-app && nest build processor-app",
    "build:staff-app": "nest build staff-app",
    "build:customer-app": "nest build customer-app",
    "build:processor-app": "nest build processor-app",
    "start:dev": "bash scripts/bash/start-dev.sh",
    "start:dev:staff-app": "nest start staff-app --watch --exec 'node --env-file=env/apps/staff-app/.env'",
    "start:dev:customer-app": "nest start customer-app --watch --exec 'node --env-file=env/apps/customer-app/.env'",
    "start:dev:processor-app": "nest start processor-app --watch --exec 'node --env-file=env/apps/processor-app/.env'",
    "start:prod:staff-app": "node dist/apps/staff-app/main.js",
    "start:prod:customer-app": "node dist/apps/customer-app/main.js",
    "start:prod:processor-app": "node dist/apps/processor-app/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pretty-quick --staged && lint-staged",
    "lint:all": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p migrations && tsc -p scripts && tsc -p test/infra && tsc -p test/system",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --logHeapUsage --maxWorkers=1 --workerIdleMemoryLimit=2GB --config ./jest/jest-unit.config.js",
    "test:unit:coverage": "yarn test:unit --coverage",
    "test:e2e:staff": "yarn test:e2e:infra:reseed && yarn test:e2e:staff:run",
    "test:e2e:staff:run": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --logHeapUsage --runInBand --ci --config ./apps/staff-app/test/jest-e2e.config.js",
    "test:e2e:customer": "yarn test:e2e:infra:reseed && yarn test:e2e:customer:run",
    "test:e2e:customer:run": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --logHeapUsage --runInBand --ci --config ./apps/customer-app/test/jest-e2e.config.js",
    "test:e2e:processor": "yarn test:e2e:infra:reseed && yarn test:e2e:processor:run",
    "test:e2e:processor:run": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --logHeapUsage --runInBand --ci --config ./apps/processor-app/test/jest-e2e.config.js",
    "test:e2e:system:staff": "yarn test:e2e:infra:reseed && yarn test:e2e:system:staff:run",
    "test:e2e:system:staff:run": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --logHeapUsage --runInBand --ci --config ./test/system/apps/staff-app/jest-e2e.config.js",
    "test:e2e:system:customer": "yarn test:e2e:infra:reseed && yarn test:e2e:system:customer:run",
    "test:e2e:system:customer:run": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --logHeapUsage --runInBand --ci --config ./test/system/apps/customer-app/jest-e2e.config.js",
    "test:e2e": "yarn test:e2e:infra:reload && yarn test:e2e:run",
    "test:e2e:run": "node ./scripts/node/e2e-run.ts",
    "test:e2e:infra:up": "bash ./test/infra/bash/up.sh",
    "test:e2e:infra:down": "docker compose -f ./test/infra/docker/docker-compose.yml down --remove-orphans --volumes",
    "test:e2e:infra:reload": "yarn test:e2e:infra:down && yarn test:e2e:infra:up",
    "test:e2e:infra:reseed": "bash ./test/infra/bash/reseed.sh",
    "test:e2e:infra:seed": "node ./test/infra/seed/index.ts",
    "migration:cli": "node ./node_modules/typeorm/cli.js -d ./migrations/config/data-source.ts",
    "migration:create": "node ./scripts/node/migration-create.ts",
    "migration:run": "yarn migration:cli migration:run",
    "migration:revert": "yarn migration:cli migration:revert",
    "migration:show": "yarn migration:cli migration:show",
    "postinstall": "husky || true"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-typeorm": "2.0.1",
    "@nestjs/bull": "12.0.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/typeorm": "12.0.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scalar/nestjs-api-reference": "1.2.31",
    "argon2": "0.45.1",
    "bull": "4.16.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "ioredis": "6.0.0",
    "joi": "18.3.0",
    "mysql2": "3.24.6",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@rspack/core": "2.2.9",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "pretty-quick": "4.2.2",
    "supertest": "7.3.1",
    "ts-checker-rspack-plugin": "1.7.2",
    "ts-jest": "29.4.15",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "webpack-node-externals": "3.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
