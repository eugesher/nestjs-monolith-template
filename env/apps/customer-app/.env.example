# Copy to .env.local (gitignored) and fill in real values for local development:
#
#   cp env/apps/customer-app/.env.example env/apps/customer-app/.env.local
#
# customer-app validates these variables at boot (apps/customer-app/src/app/setup/config):
# a missing or invalid required value stops the app with a Joi error instead of failing at
# first use.

NODE_ENV=development

PORT=3000
API_PREFIX=api
# API_USE_API_REFERENCE=true   # defaults to true outside production

DATABASE_URL=mysql://acme:acmepass@localhost:3306/acme_db
DATABASE_LOGGING=true

REDIS_URL=redis://localhost:6379
# Every Redis command fails after this long, so a dead Redis never stalls a request.
REDIS_COMMAND_TIMEOUT_MS=500
CACHE_TTL_MS_DEFAULT=60000

# Attempts of an optimistic-concurrency write before it surfaces a 409 VERSION_MISMATCH.
OCC_RETRY_ATTEMPTS=5

# Idempotency-key retention. Keep it longer than any client's retry budget: purging a
# record retires the ability to recognize that request as a replay.
IDEMPOTENCY_KEY_TTL_HOURS=24

# 32+ characters. A development throwaway, never a real secret.
JWT_SECRET=development-secret-do-not-use-in-prod-32
# Once the access token expires, the user logs in again.
JWT_EXPIRES_IN=7d

# argon2id cost parameters (OWASP guidance).
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Tracing is off by default so the app runs without a collector. The tracer starts before
# this file is loaded, so OTEL_SDK_DISABLED=false works only from the process environment.
OTEL_SDK_DISABLED=true
# OTEL_SERVICE_NAME=customer-app   # defaults to the app name
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=team=platform
