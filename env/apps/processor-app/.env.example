# Copy to .env for a local run and to .env.test for the e2e suites (both gitignored):
#
#   cp env/apps/processor-app/.env.example env/apps/processor-app/.env
#   cp env/apps/processor-app/.env.example env/apps/processor-app/.env.test
#
# The values connect to the infrastructure of `yarn test:e2e:infra:up`.
# processor-app validates every variable at boot (apps/processor-app/src/app/setup/config):
# a missing or invalid value stops the app with a Joi error instead of failing at first use.

NODE_ENV=development

PORT=3002
API_PREFIX=api
API_USE_API_REFERENCE=true

DATABASE_URL=mysql://root:root@127.0.0.1:3307/acme_db
DATABASE_LOGGING=false

REDIS_URL=redis://:e2e-redis-password@127.0.0.1:6380
# Every Redis command fails after this long, so a dead Redis never stalls a health probe.
REDIS_COMMAND_TIMEOUT_MS=500

# Idempotency-key retention. Keep it longer than any client's retry budget: purging a
# record retires the ability to recognize that request as a replay.
IDEMPOTENCY_KEY_TTL_HOURS=24

# Attempts of a ledger write before the record is logged at error for a replay.
LEDGER_RETRY_ATTEMPTS=3

# Attempts of any other enqueue before the job is logged at error for a replay.
QUEUE_RETRY_ATTEMPTS=3

# 32+ characters, the same as staff-app: either app accepts the access tokens of the other.
JWT_SECRET=e2e-secret-at-least-32-characters-long
# Once the access token expires, the user logs in again.
JWT_EXPIRES_IN=30d

# argon2id cost parameters (OWASP guidance), the same as staff-app.
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Tracing is off so the app runs without a collector. The tracer starts before
# this file is loaded, so OTEL_SDK_DISABLED=false works only from the process environment.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=processor-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
