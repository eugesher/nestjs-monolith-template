NODE_ENV=development

PORT=3002
API_PREFIX=api
API_USE_API_REFERENCE=true

DATABASE_URL=mysql://root:root@127.0.0.1:3307/acme_db
DATABASE_LOGGING=false

REDIS_URL=redis://:e2e-redis-password@127.0.0.1:6380
REDIS_COMMAND_TIMEOUT_MS=500

IDEMPOTENCY_KEY_TTL_HOURS=24

LEDGER_RETRY_ATTEMPTS=3

QUEUE_RETRY_ATTEMPTS=3

JWT_SECRET=e2e-secret-at-least-32-characters-long
JWT_EXPIRES_IN=30d

AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

LOG_LEVEL=info

OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=processor-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
