# Copy to .env.local (gitignored) and fill in real values for local development:
#
#   cp env/apps/processor-app/.env.example env/apps/processor-app/.env.local
#
# processor-app validates these variables at boot (apps/processor-app/src/app/setup/config):
# a missing or invalid required value stops the app with a Joi error instead of failing at
# first use.

NODE_ENV=development

PORT=3002
API_PREFIX=api
# API_USE_API_REFERENCE=true   # defaults to true outside production

DATABASE_URL=mysql://acme:acmepass@localhost:3306/acme_db
DATABASE_LOGGING=true

REDIS_URL=redis://localhost:6379
# Every Redis command fails after this long, so a dead Redis never stalls a health probe.
REDIS_COMMAND_TIMEOUT_MS=500

# Idempotency-key retention. Keep it longer than any client's retry budget: purging a
# record retires the ability to recognize that request as a replay.
IDEMPOTENCY_KEY_TTL_HOURS=24

# Attempts of a ledger write before the record is logged at error for a replay.
LEDGER_RETRY_ATTEMPTS=3

# Attempts of any other enqueue before the job is logged at error for a replay.
QUEUE_RETRY_ATTEMPTS=3

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Tracing is off by default so the app runs without a collector. The tracer starts before
# this file is loaded, so OTEL_SDK_DISABLED=false works only from the process environment.
OTEL_SDK_DISABLED=true
# OTEL_SERVICE_NAME=processor-app   # defaults to the app name
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=team=platform
