NODE_ENV=test

PORT=3002
API_PREFIX=api
API_USE_API_REFERENCE=true

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=acme_db
DATABASE_LOGGING=false
DATABASE_SSL_CA=

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=e2e-redis-password
REDIS_TLS_CA=
REDIS_COMMAND_TIMEOUT_MS=500

IDEMPOTENCY_KEY_TTL_HOURS=24
IDEMPOTENCY_IN_FLIGHT_TTL_MINUTES=5

LEDGER_RETRY_ATTEMPTS=3

QUEUE_RETRY_ATTEMPTS=3

JWT_SECRET=e2e-secret-at-least-32-characters-long
JWT_EXPIRES_IN=12h

AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_MAX_CONCURRENCY=4
AUTH_ARGON2_QUEUE_TIMEOUT_MS=10000

HTTP_TRUST_PROXY_HOPS=1
HTTP_CORS_ORIGINS=https://app.example.test
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10000
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=100

LOG_LEVEL=info

OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=processor-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4320
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
