# Copy to .env for `yarn migration:*` and to .env.test for the e2e infrastructure (both gitignored):
#
#   cp env/migrations/.env.example env/migrations/.env
#   cp env/migrations/.env.example env/migrations/.env.test
#
# The value connects to the infrastructure of `yarn test:e2e:infra:up`. The migration CLI reads only
# the database it migrates (migrations/config/data-source.ts).

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=acme_db
